[Unit]
Description=AlphaX Agents OS SQLite backup
After=alphax-agents-os.service

[Service]
Type=oneshot
User=alphax
Group=alphax
Environment=ALPHAX_HOME=/var/lib/alphax-agents-os
ExecStart=/bin/bash /opt/alphax-agents-os/current/scripts/backup-local.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alphax-agents-os
