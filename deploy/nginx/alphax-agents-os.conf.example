# Production reverse-proxy example.
# Install this as an nginx server block and provide real certificates.
# AlphaX itself remains bound to 127.0.0.1:8455.

limit_req_zone $binary_remote_addr zone=alphax_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=alphax_auth:10m rate=5r/m;

server {
    listen 443 ssl http2;
    server_name agents.example.invalid;

    ssl_certificate     /etc/letsencrypt/live/agents.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agents.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 5m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location = /api/auth/login {
        limit_req zone=alphax_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8455;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        limit_req zone=alphax_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8455;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8455;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8455;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80;
    server_name agents.example.invalid;
    return 301 https://$host$request_uri;
}
