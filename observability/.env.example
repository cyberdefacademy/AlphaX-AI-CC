# AlphaX Observability stack - configuration
# Copy to .env and edit. Never commit secrets.

# Prometheus TSDB retention (e.g. 15d, 30d, 90d)
PROM_RETENTION=30d

# Loki log retention in HOURS (720h = 30d)
LOKI_RETENTION=720h

# Grafana admin (change the password!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional GitHub OAuth for team SSO (10+ team)
GRAFANA_GITHUB_AUTH=false
GRAFANA_GITHUB_CLIENT_ID=
GRAFANA_GITHUB_CLIENT_SECRET=
GRAFANA_GITHUB_ORG=

# Alert routing (optional)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=localhost:25
SMTP_FROM=alertmanager@localhost
ALERTMANAGER_WEBHOOK=https://example.com/webhook

# Promtail host label (defaults to $HOSTNAME)
HOSTNAME=alphax