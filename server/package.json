{
  "name": "alphax-agents-os-server",
  "version": "1.0.0",
  "private": true,
  "description": "AlphaX Agents OS server - detection, registry, and control-plane API.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:security": "tsx src/security-regression.ts",
    "test:safety": "tsx src/safety-regression.ts",
    "test:mcp": "tsx src/mcp-provider-selftest.ts",
    "test:intelligence": "tsx src/intelligence-regression.ts",
    "test:production": "tsx src/production-readiness-regression.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
